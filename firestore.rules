rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing data model: users/{uid} stores profiles; friends, friendRequests,
    // messages, groups, calls/candidates, postcards/comments store app content.
    // bans/{uid} stores permanent (bool) and expiresAt (timestamp or null).
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'conversando@admin.com';
    }
    function banPath() {
      return /databases/$(database)/documents/bans/$(request.auth.uid);
    }
    function isBanned() {
      return signedIn() && exists(banPath()) &&
        (get(banPath()).data.permanent == true ||
         (get(banPath()).data.expiresAt is timestamp &&
          get(banPath()).data.expiresAt > request.time));
    }
    function activeUser() { return signedIn() && !isBanned(); }
    function validUser() {
      return request.resource.data.get('name', null) is string &&
        request.resource.data.get('email', null) is string;
    }
    function validFriend() {
      return request.resource.data.get('userId', null) is string &&
        request.resource.data.get('friendId', null) is string;
    }
    function validFriendRequest() {
      return request.resource.data.get('fromUserId', null) is string &&
        request.resource.data.get('toUserId', null) is string;
    }
    function validMessage() {
      return request.resource.data.get('senderId', null) is string;
    }
    function validGroup() {
      return request.resource.data.get('createdBy', null) is string &&
        request.resource.data.get('members', null) is list &&
        request.resource.data.get('admins', []) is list &&
        request.resource.data.createdBy in request.resource.data.members &&
        request.resource.data.members.hasAll(request.resource.data.get('admins', [])) &&
        !(request.resource.data.createdBy in request.resource.data.get('admins', []));
    }
    function validCall() {
      return request.resource.data.get('from', null) is string &&
        request.resource.data.get('to', null) is string &&
        request.resource.data.get('status', null) is string;
    }
    function validCandidate() {
      return request.resource.data.get('from', null) is string &&
        request.resource.data.get('candidate', null) is map;
    }
    function validPostcard() {
      return request.resource.data.get('authorId', null) is string &&
        request.resource.data.get('imageBase64', '') is string &&
        request.resource.data.get('imageBase64', '').size() < 1000000;
    }
    function validComment() {
      return request.resource.data.get('authorId', null) is string;
    }

    match /bans/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if (activeUser() || isOwner(userId));
      allow list: if activeUser();
      allow create: if activeUser() && isOwner(userId) && validUser() &&
        !request.resource.data.keys().hasAny(['isAdmin']);
      allow update: if validUser() &&
        ((activeUser() && isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])) || isAdmin());
      allow delete: if isAdmin();
    }

    match /friends/{friendId} {
      allow read: if activeUser();
      allow create: if activeUser() && validFriend() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.friendId == request.auth.uid || isAdmin());
      allow update: if activeUser() && isAdmin() && validFriend();
      allow delete: if isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if activeUser() &&
        (resource.data.get('fromUserId', null) == request.auth.uid ||
         resource.data.get('toUserId', null) == request.auth.uid || isAdmin());
      allow create: if activeUser() && validFriendRequest() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update: if activeUser() && validFriendRequest() &&
        (resource.data.get('fromUserId', null) == request.auth.uid ||
         resource.data.get('toUserId', null) == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if activeUser();
      allow create: if activeUser() && validMessage() &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if activeUser() && isAdmin() && validMessage();
      allow delete: if activeUser() &&
        (resource.data.get('senderId', null) == request.auth.uid || isAdmin());
    }

    match /groups/{groupId} {
      allow read: if activeUser();
      allow create: if activeUser() && validGroup() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.get('admins', []) == [];
      allow update: if activeUser() && validGroup() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'icon', 'members', 'admins']) &&
        (request.auth.uid == resource.data.createdBy ||
         request.auth.uid in resource.data.get('admins', [])) &&
        (request.auth.uid == resource.data.createdBy ||
         (request.resource.data.get('admins', []) ==
            resource.data.get('admins', []).removeAll(
              resource.data.members.removeAll(request.resource.data.members)) &&
          request.auth.uid in request.resource.data.members));
      allow delete: if activeUser() &&
        (resource.data.get('createdBy', null) == request.auth.uid || isAdmin());
    }

    match /calls/{callId} {
      allow read: if activeUser();
      allow create, update: if activeUser() && validCall();
      allow delete: if activeUser();
      match /candidates/{candidateId} {
        allow read: if activeUser();
        allow create, update: if activeUser() && validCandidate();
        allow delete: if activeUser();
      }
    }

    match /postcards/{postcardId} {
      allow read: if activeUser();
      allow create: if activeUser() && validPostcard() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if activeUser() && validPostcard();
      allow delete: if activeUser() &&
        (resource.data.get('authorId', null) == request.auth.uid || isAdmin());
      match /comments/{commentId} {
        allow read: if activeUser();
        allow create: if activeUser() && validComment() &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if activeUser() &&
          (resource.data.get('authorId', null) == request.auth.uid || isAdmin());
      }
    }
  }
}
