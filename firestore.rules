rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function groupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }
    function directParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if self(userId) && !request.resource.data.keys().hasAny(['isAdmin']);
      allow update: if self(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'avatar', 'avatarUpdatedAt', 'lastNameChange', 'friendCode', 'fcmToken', 'fcmTokenUpdatedAt'
      ]);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow get, list: if signedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /friends/{friendshipId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.friendId == request.auth.uid);
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow get, list: if groupMember(groupId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /messages/{messageId} {
      allow get, list: if signedIn() && ((resource.data.isGroup == true && groupMember(resource.data.groupId)) ||
        (resource.data.isGroup != true && directParticipant()));
      allow create: if signedIn() && ((request.resource.data.isGroup == true && groupMember(request.resource.data.groupId) &&
        request.resource.data.senderId == request.auth.uid) ||
        (request.resource.data.isGroup != true && request.auth.uid in request.resource.data.participants &&
          (request.resource.data.senderId == request.auth.uid ||
            (request.resource.data.senderId == 'conversina_ai_bot' && request.resource.data.participants.hasAll([request.auth.uid, 'conversina_ai_bot'])))));
      allow update: if false;
      allow delete: if signedIn() && resource.data.isGroup != true && directParticipant();
    }

    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow get, list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt']);
      allow delete: if false;
      match /candidates/{candidateId} {
        allow get, list: if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
        allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
          (get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
           get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /postcards/{postcardId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'shareCount']));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
      match /comments/{commentId} {
        allow get, list: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /passwordResetRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if admin();
    }
    match /followers/{followerId} {
      allow get, list: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
