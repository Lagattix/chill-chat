rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function callParticipant(callId) {
      return signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid ||
        get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
    }
    function groupMember(groupId) {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if (signedIn() && request.auth.uid == userId) || admin();
      allow delete: if admin();
    }
    match /friends/{friendshipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid ||
        request.resource.data.friendId == request.auth.uid || admin());
      allow update, delete: if admin();
    }
    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if admin();
    }
    match /messages/{messageId} {
      // Historical messages have no participant field, so access stays limited to signed-in users until migration.
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.senderId == request.auth.uid ||
        (request.resource.data.senderId == 'conversina_ai_bot' &&
         request.auth.uid in request.resource.data.participants));
      allow update: if admin();
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || admin());
    }
    match /groups/{groupId} {
      allow read: if groupMember(groupId) || admin();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || admin());
    }
    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow get, list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt']);
      allow delete: if false;
      match /candidates/{candidateId} {
        allow get, list: if callParticipant(callId);
        allow create: if callParticipant(callId) && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /postcards/{postcardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid &&
        request.resource.data.imageBase64 is string && request.resource.data.imageBase64.size() < 1000000;
      allow update: if signedIn() && (resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'shareCount']));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
      }
    }
    match /passwordResetRequests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if admin();
    }
    match /followers/{followerId} {
      allow get, list: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
